# Local development only. Provider requests are off unless the corresponding
# explicit live-test flag is enabled. Never use VITE_ for server credentials.
PORT=5000
NODE_ENV=development
PUBLIC_DEMO_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
GEMINI_LIVE_TEST_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL_ID=
GROQ_LIVE_TEST_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=
OPENROUTER_LIVE_TEST_ENABLED=false
AI_FREE_FALLBACK_ENABLED=false

# Required outside development. Generate a unique, high-entropy value privately.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Public frontend configuration. This is an API origin, not a credential.
VITE_API_BASE_URL=
FRONTEND_ORIGINS=http://localhost:5000,http://localhost:5173
TRUST_PROXY_HOPS=0
AUTH_COOKIE_SAME_SITE=lax

# Trial policy. Values apply to newly created workspaces; existing trial dates remain unchanged.
TRIAL_DURATION_DAYS=7
TRIAL_AI_ACTION_LIMIT=25
TRIAL_INCLUDED_AI_ACTIONS=adviser,research,strategy,text_content
SUPPORT_CONTACT_URL=

# Supabase client initialization only; product reads/writes still use local JSON.
SUPABASE_URL=
SUPABASE_ANON_KEY=
